# Network Sniffer Tool Configuration File
# Copy this file to .env and fill in your values

# ============================================================
# Authentication
# ============================================================
# Default admin credentials (change on first login)
APP_USERNAME=admin
APP_PASSWORD=changeme123

# ============================================================
# SMTP Alert Configuration (Optional)
# ============================================================
# Leave empty to disable email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=

# ============================================================
# IDS Thresholds (Optional - adjust as needed)
# ============================================================
# SYN flood detection: number of SYN packets per second from single source
IDS_SYN_FLOOD_THRESHOLD=100
# Port scan detection: number of distinct ports scanned from single source in window
IDS_PORT_SCAN_THRESHOLD=20
# Time window in seconds for IDS detection
IDS_DETECTION_WINDOW=60
